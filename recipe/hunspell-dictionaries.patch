Conda's dictionary packages install to share/hunspell_dictionaries.
Resolve that directory relative to the library so relocated environments work.

--- a/providers/enchant_hunspell.cpp
+++ b/providers/enchant_hunspell.cpp
@@ -218,6 +218,10 @@ s_buildDictionaryDirs (EnchantProvider * me, std::vector<std::string> & dirs)
 	dirs.push_back (tmp);
 	g_free(tmp);
 
+	tmp = enchant_relocate (ENCHANT_HUNSPELL_DICT_DIR "_dictionaries");
+	dirs.push_back (tmp);
+	g_free (tmp);
+
 	for (const gchar* const * iter = g_get_system_data_dirs (); *iter; iter++) {
 		tmp = g_build_filename (*iter, me->identify (me), nullptr);
 		dirs.push_back (tmp);
